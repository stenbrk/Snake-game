<!DOCTYPE html>
<html>

<head>
    <title>Snake Game</title>
    <style>
        body {
            text-align: center;
            color: white;
            font-family: Arial;
            background: #1a1a1a;
           
        }

        canvas {
            background: black;
            display: block;
            margin: auto;
            border: 2px solid white;
            /* witte lijn rond het speelveld */
        }

        #overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }

        #overlay button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 10px;
        }
    </style>
</head>

<body>

    <h2>🐍 Snake</h2>
    <p id="score">Score: 0</p>

    <canvas id="game" width="400" height="400" tabindex="0"></canvas>

    <div id="overlay">
        <h1>💀 Game Over</h1>
        <button onclick="restartGame()">Opnieuw spelen</button>
    </div>

    <script>
        const canvas = document.getElementById("game");
        const ctx = canvas.getContext("2d");
        canvas.focus();

        let snake, direction, nextDirection, food, score, gameRunning;

        let lastTime = 0;
        let moveInterval = 90; // snelheid
        let accumulator = 0;

        // input
        document.addEventListener("keydown", (e) => {
            if (!gameRunning) return;

            if (e.key === "ArrowUp" && direction.y === 0)
                nextDirection = {
                    x: 0,
                    y: -20
                };

            if (e.key === "ArrowDown" && direction.y === 0)
                nextDirection = {
                    x: 0,
                    y: 20
                };

            if (e.key === "ArrowLeft" && direction.x === 0)
                nextDirection = {
                    x: -20,
                    y: 0
                };

            if (e.key === "ArrowRight" && direction.x === 0)
                nextDirection = {
                    x: 20,
                    y: 0
                };
        });

        // init
        function initGame() {
            snake = [{
                x: 200,
                y: 200
            }];
            direction = {
                x: 20,
                y: 0
            };
            nextDirection = {
                x: 20,
                y: 0
            };

            food = {
                x: Math.floor(Math.random() * 20) * 20,
                y: Math.floor(Math.random() * 20) * 20
            };

            score = 0;
            gameRunning = true;

            document.getElementById("score").innerText = "Score: 0";
            document.getElementById("overlay").style.display = "none";

            lastTime = 0;
            accumulator = 0;

            requestAnimationFrame(gameLoop);
        }

        // loop
        function gameLoop(time) {
            if (!lastTime) lastTime = time;
            let delta = time - lastTime;
            lastTime = time;

            accumulator += delta;

            while (accumulator >= moveInterval) {
                if (gameRunning) update();
                accumulator -= moveInterval;
            }

            draw();

            if (gameRunning)
                requestAnimationFrame(gameLoop);
        }

        // update
        function update() {
            direction = nextDirection;

            let head = {
                x: snake[0].x + direction.x,
                y: snake[0].y + direction.y
            };

            // collision
            if (
                head.x < 0 || head.x >= 400 ||
                head.y < 0 || head.y >= 400 ||
                snake.some(p => p.x === head.x && p.y === head.y)
            ) {
                gameRunning = false;
                document.getElementById("overlay").style.display = "flex";
                return;
            }

            snake.unshift(head);

            if (head.x === food.x && head.y === food.y) {
                score += 10;
                document.getElementById("score").innerText = "Score: " + score;

                food.x = Math.floor(Math.random() * 20) * 20;
                food.y = Math.floor(Math.random() * 20) * 20;
            } else {
                snake.pop();
            }
        }

        // draw
        function draw() {
            ctx.fillStyle = "black";
            ctx.fillRect(0, 0, 400, 400);

            ctx.fillStyle = "lime";
            snake.forEach(part => {
                ctx.fillRect(part.x, part.y, 20, 20);
            });

            ctx.fillStyle = "red";
            ctx.fillRect(food.x, food.y, 20, 20);
        }

        // restart
        function restartGame() {
            initGame();
        }

        // start
        initGame();
    </script>

</body>

</html>
